  "encoding": {
    "y": {
      "field": "abbr",
      "type": "nominal",
      "sort": [
        "NSW",
        "VIC",
        "QLD",
        "WA",
        "SA",
        "TAS",
        "NT",
        "ACT"
      ],
      "scale": {
        "paddingInner": 0.3,
        "paddingOuter": 0.15
      },
      "axis": {
        "title": null,
        "domain": false,
        "ticks": false,
        "labelPadding": 9,
        "labelFont": "DM Sans",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelColor": "#223E55"
      }
    },
    "x": {
      "field": "records",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          28000
        ],
        "nice": false
      },
      "axis": {
        "title": "Number of occurrence records",
        "titleFont": "DM Sans",
        "titleFontSize": 12,
        "titleColor": "#344A5A",
        "titlePadding": 12,
        "labelFont": "DM Sans",
        "labelFontSize": 11,
        "labelColor": "#566E82",
        "values": [
          0,
          5000,
          10000,
          15000,
          20000,
          25000
        ],
        "format": "~s",
        "grid": true,
        "gridColor": "#E6EEF4",
        "domain": false,
        "ticks": false
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "records",
        "type": "quantitative",
        "title": "Bird records",
        "format": ","
      },
      {
        "field": "species",
        "type": "quantitative",
        "title": "Total species"
      },
      {
        "field": "species_at_500",
        "type": "quantitative",
        "title": "Species per 500 records",
        "format": ".1f"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "strokeCap": "round"
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "records"
        },
        "color": {
          "condition": [
            {
              "test": "datum.abbr === 'NSW'",
              "value": "#8A4C79"
            }
          ],
          "value": "#426B92"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "filled": true
      },
      "encoding": {
        "color": {
          "condition": [
            {
              "test": "datum.abbr === 'NSW'",
              "value": "#8A4C79"
            }
          ],
          "value": "#426B92"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "font": "DM Sans",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#223E55"
      },
      "encoding": {
        "text": {
          "field": "records",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelLimit": 100
    }
  }
