  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans"
    },
    "text": {
      "font": "DM Sans"
    },
    "legend": {
      "labelFont": "DM Sans"
    }
  }
}
